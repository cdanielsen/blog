---
import { Image } from "astro:assets"
import headshot from "../../content/assets/headshot.png"

interface Props {
  /** Rendered width in px; the image is square. */
  size: number
  class?: string
}

const { size, class: className } = Astro.props
---

<Image
  src={headshot}
  alt="Christian Danielsen"
  width={size}
  height={size}
  densities={[1, 2]}
  class={className}
/>
