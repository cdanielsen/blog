---
import { SITE } from "../consts"

interface Props {
  variant: "index" | "page"
}

const { variant } = Astro.props
---

{variant === "index" ? (
  <header>
    <h1 class="masthead">
      <a href="/">{SITE.masthead}</a>
    </h1>
    <h4 class="tagline">{SITE.description}</h4>
  </header>
) : (
  <header>
    <h1 class="site-title">
      <a href="/">{SITE.title}</a>
    </h1>
  </header>
)}

<style>
  h1 {
    margin-top: 0;
    text-align: center;
  }
  h1 a {
    color: inherit;
  }
  .masthead {
    font-size: 2.5rem;
    line-height: 3.5rem;
    margin-bottom: 1.75rem;
  }
  .tagline {
    text-align: center;
    margin: 1rem auto;
  }
  .site-title {
    font-family: Montserrat, sans-serif;
  }
</style>
