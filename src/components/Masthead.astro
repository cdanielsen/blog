---
import { SITE } from "../consts"

// Full size on the index; a shorter version everywhere else so content starts
// higher up. The masthead is the page's h1 only on the index.
const isIndex = Astro.url.pathname === "/"
const Tag = isIndex ? "h1" : "p"
const [before, after] = SITE.masthead.split("===")
---

<header class:list={["masthead", "grid-panel", { compact: !isIndex }]}>
  <Tag class="expr">
    <a href="/">
      {before}
      <span class="op">===</span>
      {after}
    </a>
  </Tag>
  <p class="tagline">{SITE.description}</p>
</header>

<style>
  .masthead {
    margin-top: 56px;
    padding: 64px 32px 56px;
    text-align: center;
  }
  .expr {
    margin: 0;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: clamp(36px, 8vw, 60px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .op {
    color: var(--accent);
  }
  .tagline {
    margin: 20px 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 20px;
    color: var(--muted);
  }

  .compact {
    margin-top: 40px;
    padding: 32px 24px 28px;
  }
  .compact .expr {
    font-size: clamp(26px, 5vw, 36px);
  }
  .compact .tagline {
    margin-top: 10px;
    font-size: 16px;
  }
</style>
