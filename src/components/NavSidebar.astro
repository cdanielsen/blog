---
import Headshot from "./Headshot.astro"
import IconBox from "./IconBox.astro"
import { ADMIREES } from "../consts"
---

<nav class="nav-sidebar">
  <Headshot size={112} class="headshot" />
  <div class="links">
    <h4 class="nav-link">
      <a href="/about">This Guy</a>
    </h4>
    <h4 class="nav-link">
      <a href="/resume.pdf" target="_blank">
        Resume
      </a>
    </h4>
    <IconBox />
    <div class="admirees">
      <h4>Admirees</h4>
      <div data-shuffle>
        {ADMIREES.map(([name, href]) => (
          <div>
            <a href={href}>{name}</a>
          </div>
        ))}
      </div>
    </div>
  </div>
</nav>

<script>
  import { shuffleChildren } from "../scripts/shuffle"

  document
    .querySelectorAll<HTMLElement>("[data-shuffle]")
    .forEach(shuffleChildren)
</script>

<style>
  .nav-sidebar {
    display: flex;
    flex-direction: column;
    min-width: 125px;
  }
  .nav-sidebar :global(.headshot) {
    display: block;
    margin: 0 auto;
    width: 7rem;
    height: 7rem;
  }
  .links {
    flex-grow: 1;
  }
  .nav-link {
    text-align: center;
    margin-top: 14px;
    margin-bottom: 14px;
  }
  .admirees {
    text-align: center;
  }
</style>
