---
import Layout from "../layouts/Layout.astro"
import { SITE } from "../consts"
import {
  formatDate,
  getSortedPosts,
  postDescription,
  postPath,
} from "../lib/posts"

const posts = await getSortedPosts()
---

<Layout title="All posts">
  <section class="hero grid-panel">
    <h1 class="masthead">
      {"{} - [] "}
      <span class="op">===</span>
      {" -0"}
      <span class="cursor" aria-hidden="true"></span>
    </h1>
    <p class="tagline">{SITE.description}</p>
  </section>

  <section class="posts">
    <h2 class="label">// posts</h2>
    {posts.map((post) => (
      <a class="row" href={postPath(post)}>
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <div>
          <h3>
            <span class="prompt" aria-hidden="true">
              &gt;
            </span>
            {post.data.title}
          </h3>
          <p>{postDescription(post)}</p>
        </div>
      </a>
    ))}
  </section>
</Layout>

<style>
  .hero {
    margin-top: 56px;
    padding: 64px 32px 56px;
    text-align: center;
  }
  .masthead {
    margin: 0;
    font-family: var(--font-mono);
    font-size: clamp(36px, 8vw, 60px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .op {
    color: var(--accent);
  }
  .cursor {
    display: inline-block;
    width: 0.5em;
    height: 0.9em;
    margin-left: 0.15em;
    vertical-align: -0.08em;
    background: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
  .tagline {
    margin: 20px 0 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 20px;
    color: var(--muted);
  }

  .posts {
    margin-top: 64px;
  }
  .row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 4px 24px;
    padding: 22px 0;
    border-top: 1px solid var(--rule);
  }
  time {
    padding-top: 5px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  h3 {
    margin: 0;
    font-size: 22px;
    line-height: 1.3;
  }
  .prompt {
    margin-right: 10px;
    font-family: var(--font-mono);
    color: var(--muted);
    opacity: 0.6;
  }
  .row p {
    margin: 4px 0 0;
    font-size: 16px;
    color: var(--muted);
  }
  .row:hover h3,
  .row:focus-visible h3,
  .row:hover .prompt,
  .row:focus-visible .prompt {
    color: var(--accent);
    opacity: 1;
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    time {
      padding-top: 0;
    }
  }
</style>
