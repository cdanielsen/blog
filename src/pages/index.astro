---
import Layout from "../layouts/Layout.astro"
import {
  formatDate,
  getSortedPosts,
  postDescription,
  postPath,
} from "../lib/posts"

const posts = await getSortedPosts()
---

<Layout title="All posts">
  <section class="posts">
    <h2 class="label">// posts</h2>
    {posts.map((post) => (
      <a class="row" href={postPath(post)}>
        <time datetime={post.data.date.toISOString()}>
          {formatDate(post.data.date)}
        </time>
        <div>
          <h3>
            <span class="prompt" aria-hidden="true">
              &gt;
            </span>
            {post.data.title}
          </h3>
          <p>{postDescription(post)}</p>
        </div>
      </a>
    ))}
  </section>
</Layout>

<style>
  .posts {
    margin-top: 64px;
  }
  .row {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 4px 24px;
    padding: 22px 0;
    border-top: 1px solid var(--rule);
  }
  time {
    padding-top: 5px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
  }
  h3 {
    margin: 0;
    font-size: 22px;
    line-height: 1.3;
  }
  .prompt {
    margin-right: 10px;
    font-family: var(--font-mono);
    color: var(--muted);
    opacity: 0.6;
  }
  .row p {
    margin: 4px 0 0;
    font-size: 16px;
    color: var(--muted);
  }
  .row:hover h3,
  .row:focus-visible h3,
  .row:hover .prompt,
  .row:focus-visible .prompt {
    color: var(--accent);
    opacity: 1;
  }
  @media (max-width: 640px) {
    .row {
      grid-template-columns: minmax(0, 1fr);
    }
    time {
      padding-top: 0;
    }
  }
</style>
